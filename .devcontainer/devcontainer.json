{
  "name": "Engenharia de Dados",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",

  // Precisa ser docker-in-docker: o compose usa caminhos relativos
  // (./airflow/dags, ./dbt_lakehouse), que o docker-outside-of-docker
  // resolveria no host e apontariam para o lugar errado.
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },

  // 9 containers, pico medido de ~5 GB durante o dbt build. Imagens somam ~4 GB.
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },

  // No Codespaces o acesso é pela aba PORTS, não por localhost.
  "forwardPorts": [8080, 8081, 8088, 9001, 8091],
  "portsAttributes": {
    "8080": { "label": "Airflow" },
    "8081": { "label": "Spark Master" },
    "8088": { "label": "Superset" },
    "9001": { "label": "MinIO" },
    "8091": { "label": "DBT Docs" }
  },

  // Não adianta construir as imagens do compose aqui para o prebuild aproveitar:
  // a feature docker-in-docker monta /var/lib/docker como volume nomeado
  // (dind-var-lib-docker-${devcontainerId}), e o prebuild fotografa o container,
  // não o conteúdo dos volumes. As imagens seriam descartadas. O prebuild ainda
  // adianta a imagem base, as features e o clone do repositório -- só não o
  // `docker compose up -d --build`, que roda uma vez na máquina do aluno.

  // Mesmo chmod do passo 3 do README, automatizado.
  "postCreateCommand": "sudo chmod -R 777 airflow dbt_lakehouse",

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "redhat.vscode-yaml"]
    }
  }
}
